#!/bin/sh
#
# FreeBSD ports wrapper for Anthropic Claude Code (native Bun)
#

export USE_BUILTIN_RIPGREP=false

# Updates are managed through ports/pkg. The bundled auto-updater replaces this
# installation with an npm wrapper that does not support FreeBSD, leaving a
# broken bin/claude behind (anthropics/claude-code#51833). Assignment is
# conditional, so DISABLE_AUTOUPDATER=0 in the environment still opts back in.
: ${DISABLE_AUTOUPDATER:=1}
export DISABLE_AUTOUPDATER

# Set SHELL=bash so claude uses bash for tool execution (avoids issues with
# non-bash shells like tcsh that claude's tool runner may not handle correctly).
export SHELL=%%LOCALBASE%%/bin/bash

# Claude starts further copies of itself -- background sessions, the daemon and
# its workers, teammates, relaunches -- as `bun .../cli ...`, through the
# launcher named here. Ours gives them the bun options used below. A launcher
# of your own takes precedence, and then has to add those options itself.
: ${CLAUDE_CODE_PROCESS_WRAPPER:=%%PREFIX%%/libexec/claude-code/bun-launcher}
export CLAUDE_CODE_PROCESS_WRAPPER

# Run the extracted code on FreeBSD's own Bun; cli loads what it needs beyond
# stock Bun by itself. Without the two options, bun would read any .env files
# and bunfig.toml in the current directory -- the user's project, not ours --
# and a bunfig.toml there can preload code into claude before it starts.
exec %%LOCALBASE%%/bin/bun --no-env-file --config=/dev/null \
    %%PREFIX%%/lib/node_modules/@anthropic-ai/claude-code/cli "$@"
