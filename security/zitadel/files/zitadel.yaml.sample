# Zitadel configuration for FreeBSD
# Full reference: https://zitadel.com/docs/self-hosting/manage/configure
# Defaults are in %%ETCDIR%%/defaults.yaml (do not edit).
# Override only the values you need here.

ExternalSecure: false
TLS:
  Enabled: false

# For production, set ExternalSecure: true and either enable TLS here
# or terminate TLS at a reverse proxy (nginx, caddy, etc).
#
# ExternalDomain: auth.example.com
# ExternalPort: 443

Database:
  Postgres:
    Host: localhost
    Port: 5432
    Database: zitadel
    User:
      Username: zitadel
      Password: ""
      SSL:
        Mode: disable
    Admin:
      Username: postgres
      Password: ""
      SSL:
        Mode: disable

# Use the built-in (v1) login UI served by the ZITADEL binary. ZITADEL v4
# defaults to Login v2, a separate application served at /ui/v2/login that
# this single-binary deployment does not run, so its endpoints return 404.
# This applies at instance creation; to switch an already-initialized
# instance, change the feature via the API/Console instead.
DefaultInstance:
  Features:
    LoginV2:
      Required: false
